{
  "name": "FlightCase",
  "type": "object",
  "properties": {
    "case_number": {
      "type": "string",
      "description": "Unique case reference, e.g. FG-2026-00123"
    },
    "flight_number": {
      "type": "string",
      "description": "Flight IATA code + number, e.g. DL1234"
    },
    "airline_iata": {
      "type": "string",
      "description": "Airline IATA code, e.g. DL, AA, UA"
    },
    "airline_name": {
      "type": "string"
    },
    "origin": {
      "type": "string",
      "description": "Departure airport IATA code"
    },
    "destination": {
      "type": "string",
      "description": "Arrival airport IATA code"
    },
    "scheduled_departure": {
      "type": "string",
      "format": "date-time"
    },
    "cabin_class": {
      "type": "string",
      "enum": [
        "economy",
        "premium_economy",
        "business",
        "first"
      ],
      "default": "economy"
    },
    "ticket_price_usd": {
      "type": "number",
      "description": "Original ticket price paid by user"
    },
    "disruption_type": {
      "type": "string",
      "enum": [
        "delay",
        "cancellation",
        "diversion"
      ],
      "default": "delay"
    },
    "delay_minutes": {
      "type": "number",
      "description": "Verified delay in minutes from flight status API"
    },
    "disruption_reason": {
      "type": "string"
    },
    "controllable": {
      "type": "boolean",
      "description": "Whether the disruption is within airline control (not weather/ATC)"
    },
    "flight_verified": {
      "type": "boolean",
      "default": false,
      "description": "Whether the disruption was verified via real flight status API"
    },
    "applicable_regulation": {
      "type": "string",
      "description": "Matched regulation, e.g. DOT Part 260 (Refunds)"
    },
    "max_benefit_usd": {
      "type": "number",
      "description": "Maximum total benefit the agent will pursue (refund + credits + accommodations)"
    },
    "dot_cash_value": {
      "type": "number",
      "description": "DOT-mandated cash refund value"
    },
    "airline_benefit_value": {
      "type": "number",
      "description": "Voluntary airline benefit value (credits + vouchers)"
    },
    "negotiation_strategy": {
      "type": "array",
      "description": "Step-by-step negotiation script the agent will follow",
      "items": {
        "type": "string"
      }
    },
    "user_intent": {
      "type": "string",
      "enum": [
        "rebook",
        "compensation",
        "both",
        "assistance"
      ],
      "default": "both",
      "description": "rebook = prioritize rebooking; compensation = prioritize refund/claim; both = pursue all; assistance = meals/lodging"
    },
    "channel": {
      "type": "string",
      "enum": [
        "api",
        "phone",
        "sms",
        "whatsapp",
        "app"
      ],
      "description": "Primary channel used to contact airline"
    },
    "has_airline_api": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "analyzing",
        "contacting_airline",
        "negotiating",
        "solution_received",
        "awaiting_user_confirmation",
        "completing",
        "closed_success",
        "closed_failed",
        "cancelled"
      ],
      "default": "draft"
    },
    "current_step_label": {
      "type": "string"
    },
    "solution_summary": {
      "type": "string"
    },
    "proposed_compensation_usd": {
      "type": "number"
    },
    "rebook_flight_number": {
      "type": "string"
    },
    "rebook_departure": {
      "type": "string",
      "format": "date-time"
    },
    "assistance_offered": {
      "type": "string"
    },
    "user_decision": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "rejected",
        "renegotiate"
      ],
      "default": "pending"
    },
    "fee_usd": {
      "type": "number",
      "default": 0
    },
    "fee_paid": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "flight_number",
    "origin",
    "destination",
    "disruption_type"
  ]
}